# Secrets may be supplied through environment variables instead of local JSON files.
BOH_JWT_SECRET=replace-with-a-random-32-byte-secret
BOH_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOH_ADMIN_TOKEN=replace-with-a-random-32-byte-token
# BOH_AUTH_CONFIG=/absolute/path/to/auth-config.json
# BOH_ADMIN_CONFIG=/absolute/path/to/admin-config.json
# Frost ID MySQL；也可在 auth-config.json 中填写 databaseUrl。
# 若 Frost ID 位于同级 ../frost-id，服务会自动读取其 .env 的 DATABASE_URL。
# BOH_FROST_ID_DATABASE_URL=mysql://user:password@localhost:3306/frost_id
