    {
      "id": "artillery_selected",
      "when": [{ "kind": "unitSelected", "target": { "unit": "recruit_artillery" } }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "看清了吗？草靶在两格之外。炮兵不需要移动——让火力替你跨过这段距离。\n\n直接攻击高亮草靶。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": {
            "unit": "recruit_artillery",
            "tiles": [{ "q": 0, "r": 3 }],
            "hint": "无需移动，直接进行远程攻击"
