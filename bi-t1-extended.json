      "when": [{ "kind": "eventNextIs", "value": "__cavalry_ready" }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "骑兵有 8 点行动力。你可以用它绕过正面、抢到缺口，或在敌人反应前结束战斗。\n\n点击骑兵。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": { "unit": "recruit_cavalry", "hint": "点击骑兵，查看更远的行动范围" }
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_cavalry" },
          "state": "canAct",
          "value": true
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_cavalry" },
          "state": "canMove",
          "value": true
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "cavalry_selected",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
      "id": "cavalry_selected",
      "when": [{ "kind": "unitSelected", "target": { "unit": "recruit_cavalry" } }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "草靶离得很远，步兵需要多次推进；骑兵可以一口气切入。\n\n策马移动到高亮地块。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": {
            "unit": "recruit_cavalry",
            "tiles": [{ "q": 1, "r": -1 }],
            "hint": "利用骑兵的高行动力切入目标侧面"
