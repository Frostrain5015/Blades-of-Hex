      "once": true,
      "enabled": false
    },
    {
      "id": "cavalry_moved",
      "when": [{ "kind": "unitMovesToTile", "target": { "unit": "recruit_cavalry" }, "q": 1, "r": -1 }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "现在你已经抢在敌人前面。速度不是为了逃跑；速度是为了决定交锋发生在哪里。\n\n攻击相邻草靶。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": {
            "unit": "recruit_cavalry",
            "tiles": [{ "q": 2, "r": -1 }],
            "hint": "攻击骑兵训练草靶"
