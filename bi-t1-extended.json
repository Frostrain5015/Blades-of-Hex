      "id": "artillery_ready",
      "when": [{ "kind": "eventNextIs", "value": "__artillery_ready" }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "炮兵只有 3 点行动力，但射程有 2 格。不是每一次进攻都要先冲到敌人脸上。\n\n点击炮兵。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": { "unit": "recruit_artillery", "hint": "点击炮兵，查看它的远程攻击范围" }
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_artillery" },
          "state": "canAct",
          "value": true
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_artillery" },
          "state": "canMove",
          "value": false
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "artillery_selected",
