  "triggers": [
    {
      "id": "start_story",
      "when": [{ "kind": "timer", "value": 1500 }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "阿克罗斯以北，东征军整训的第一日。\n\n新兵，站到旗帜下。这里是北境校场；从今天起，你们会在这里学会活下去。",
          "boardLock": true,
          "highlight": { "tiles": [{ "q": 0, "r": 0 }], "hint": "马库斯正在校场中央训话" }
        },
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "看着手里的血印金币。它不是赏钱，是契约：王国记住你们的名字，你们也要记住自己为何举剑。",
          "boardLock": true,
          "highlight": { "tiles": [{ "q": 0, "r": 0 }], "hint": "血印金币的授予仪式仍在继续" }
        },
        {
          "kind": "showStep",
          "text": "新兵们依次按血为印，低声复诵誓词。阳光照在金币的金箔上，像一排尚未出鞘的刀锋。",
          "boardLock": true,
          "highlight": { "tiles": [{ "q": 0, "r": 0 }], "hint": "校场中央正在举行入伍誓约" }
        },
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "仪式结束。现在开始第一课：不是如何逞强，而是如何让每一种兵器在该出现的位置出现。\n\n准备好后，点击这段话开始操练。",
          "next": "__infantry_ready",
          "boardLock": true,
          "highlight": { "unit": "recruit_infantry", "hint": "第一名新兵已经在队列前列待命" }
        },
        {
          "kind": "setUnitState",
          "target": { "group": "player_recruits" },
          "state": "canAct",
          "value": false
        },
        {
          "kind": "setUnitState",
          "target": { "group": "player_recruits" },
          "state": "canMove",
          "value": false
        },
        {
          "kind": "setUnitState",
          "target": { "group": "player_recruits" },
          "state": "canAttack",
          "value": false
        },
        {
          "kind": "setUnitState",
          "target": { "group": "training_targets" },
          "state": "canCounterattack",
          "value": false
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "infantry_ready",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": true
    },
    {
      "id": "infantry_ready",
      "when": [{ "kind": "eventNextIs", "value": "__infantry_ready" }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "先看步兵。盾在前，剑在后；他们不是最快的，却是队列的骨头。\n\n点击这名步兵，将他选中。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": { "unit": "recruit_infantry", "hint": "点击步兵，查看他的行动范围" }
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canAct",
          "value": true
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canMove",
          "value": true
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "infantry_selected",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
      "id": "infantry_selected",
      "when": [{ "kind": "unitSelected", "target": { "unit": "recruit_infantry" } }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "步兵有 5 点行动力。先稳住阵线，再把距离缩到一剑之内。\n\n移动到高亮地块，与草靶相邻。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": {
            "unit": "recruit_infantry",
            "tiles": [{ "q": 1, "r": 1 }],
            "hint": "移动到高亮地块，准备近战"
          }
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "infantry_moved",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
      "id": "infantry_moved",
      "when": [{ "kind": "unitMovesToTile", "target": { "unit": "recruit_infantry" }, "q": 1, "r": 1 }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "很好。近战的代价是贴近敌人；近战的力量，也来自你肯站在最前面。\n\n现在攻击相邻的草靶。",
          "boardLock": true,
          "dialogLock": true,
          "highlight": {
            "unit": "recruit_infantry",
            "tiles": [{ "q": 2, "r": 1 }],
            "hint": "攻击相邻的训练草靶"
          }
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canAttack",
          "value": true
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "infantry_attacked",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
      "id": "infantry_attacked",
      "when": [{ "kind": "unitAttacksUnit", "attacker": { "unit": "recruit_infantry" }, "defender": { "unit": "target_infantry" } }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "这就是步兵：推进、贴住、顶住。没有他们，任何阵线都会散。",
          "boardLock": true,
          "highlight": { "unit": "recruit_infantry", "hint": "步兵已完成第一项操练" }
        },
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "但战场不会总等你一步步走到面前。看左侧那匹战马——骑兵要学会把机会变成距离。\n\n点击这段话，开始第二项操练。",
          "next": "__cavalry_ready",
          "boardLock": true,
          "highlight": { "unit": "recruit_cavalry", "hint": "骑兵正在等待下一道口令" }
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canAct",
          "value": false
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canMove",
          "value": false
        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_infantry" },
          "state": "canAttack",
          "value": false
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "cavalry_ready",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
