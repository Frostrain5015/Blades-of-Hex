        },
        {
          "kind": "setUnitState",
          "target": { "unit": "recruit_artillery" },
          "state": "canAttack",
          "value": true
        },
        {
          "kind": "setTriggerEnabled",
          "trigger": "artillery_attacked",
          "enabled": true
        }
      ],
      "once": true,
      "enabled": false
    },
    {
      "id": "artillery_attacked",
      "when": [{ "kind": "unitAttacksUnit", "attacker": { "unit": "recruit_artillery" }, "defender": { "unit": "target_artillery" } }],
      "do": [
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "记住今天的顺序：步兵顶住阵线，骑兵夺取时机，炮兵在距离之外撕开缺口。没有哪一种兵器能独自赢下一场仗。",
          "boardLock": true,
          "highlight": { "unit": "recruit_artillery", "hint": "三项基础操练已全部完成" }
        },
        {
          "kind": "showStep",
          "speaker": { "name": "马库斯", "portrait": "centurion" },
          "text": "操典会告诉你怎样持剑，却不会替你决定剑该指向谁。\n\n剑不问方向，问方向的是持剑的人。\n\n解散。准备好后，点击这段话结束操练。",
