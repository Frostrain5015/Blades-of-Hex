{
  "name": "blades-of-hex-server",
  "version": "5.1.0",
  "description": "Blades of Hex — LAN multiplayer WebSocket server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup": "npm install --production && node server.js",
    "generate-cert": "node generate-cert.js",
    "setup-https": "node generate-cert.js && node server.js",
    "admin": "node admin/admin-server.js",
    "auth": "node auth-server.js",
    "build-admin-exe": "pkg admin/admin-server.js -t node18-win-x64 -o BladesOfHex-Admin.exe"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "optionalDependencies": {
    "ssh2": "^1.17.0"
  }
}
