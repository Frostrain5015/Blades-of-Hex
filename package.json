{
  "name": "blades-of-hex-server",
  "version": "5.1.0",
  "description": "Blades of Hex — LAN multiplayer WebSocket server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.rendering.json --pretty false",
    "setup": "npm install --production && node server.js",
    "generate-cert": "node generate-cert.js",
    "setup-https": "node generate-cert.js && node server.js",
    "admin": "node admin/admin-server.js",
    "auth": "node auth-server.js",
    "build-admin-exe": "pkg admin/admin-server.js -t node18-win-x64 -o BladesOfHex-Admin.exe",
    "test": "node test/run-all.mjs",
    "test:quick": "node test/run-all.mjs --quick"
  },
  "dependencies": {
    "mysql2": "^3.22.6",
    "pixi.js": "^8.19.0",
    "sharp": "^0.35.3",
    "ws": "^8.17.0"
  },
  "optionalDependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
